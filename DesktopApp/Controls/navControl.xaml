<UserControl x:Class="DesktopApp.Controls.navControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border x:Name="SidebarContainer"
         Width="80"
         Padding="8"
         Background="{StaticResource BackgroundBrush2}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                  To="250"
                                                  Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                  To="80"
                                                  Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" 
                Source="/Resources/images/icono_proyecto.png"
                Stretch="Uniform"
                Height="150"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                <ListBox x:Name="MainMenu"
                         Background="Transparent"
                        Grid.Row="1"
                        BorderThickness="0" 
                        HorizontalContentAlignment="Center"
                        SelectedValuePath="Tag"
                        SelectedValue="{Binding SelectedMenu, Mode=TwoWay}">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Margin="10 10" Tag="dashboard">
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="dashboard"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource PrimaryBrush}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Data="{StaticResource IcoDashboard}"/>
                                <TextBlock Text="Dashboard"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                    </ListBoxItem>

                    <ListBoxItem  Margin="10 10" Tag="bookings">
                        <Button Command="{Binding NavigateCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                CommandParameter="bookings"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource PrimaryBrush}"
                                    Width="18" Height="18" Stretch="Uniform"
                                    Data="{StaticResource IcoReservations}"/>
                                <TextBlock Text="Reservas"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                    </ListBoxItem>

                    <ListBoxItem  Margin=" 10 10" Tag="rooms">
                        <Button Command="{Binding NavigateCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                CommandParameter="rooms"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource PrimaryBrush}"
                                        Width="18" Height="18" Stretch="Uniform"
                                        Data="{StaticResource IcoRooms}"
                                />
                                <TextBlock Text="Habitaciones"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                    </ListBoxItem>

                    <ListBoxItem  Margin=" 10 10" Tag="invoices">
                        <Button Command="{Binding NavigateCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            CommandParameter="invoices"
                            Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="{StaticResource PrimaryBrush}"
                                    Width="18" Height="18" Stretch="Uniform"
                                    Data="{StaticResource IcoInvoices}"
                                />
                                <TextBlock Text="Facturas"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SidebarTextStyle}"/>
                            </StackPanel>
                        </Button>
                    </ListBoxItem>

                </ListBox>

                <!-- MENÚ INFERIOR -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0" >
                    <Separator Opacity="0.25"/>

                    <ListBox x:Name="SubMenu" Background="Transparent" BorderThickness="0" 
                            HorizontalContentAlignment="Center"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding SelectedMenu, Mode=TwoWay}">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBoxItem Margin="10 10" Tag="audit"
                             Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button Command="{Binding NavigateCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            CommandParameter="audit"
                            Style="{StaticResource SidebarItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Fill="{StaticResource PrimaryBrush}"
                                          Width="18" Height="18" Stretch="Uniform"
                                          Data="{StaticResource IcoLogs}"/>
                                    <TextBlock Text="Auditoría"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SidebarTextStyle}"/>
                                 </StackPanel>
                            </Button>
                        </ListBoxItem>

                        <ListBoxItem Tag="power">
                            <Button Command="{Binding NavigateCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                CommandParameter="power"
                                Style="{StaticResource SidebarItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Fill="{StaticResource PrimaryBrush}"
                                        Width="18" Height="18" Stretch="Uniform"
                                        Data="{StaticResource IcoPower}"/>
                                    <TextBlock Text="Salir"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SidebarTextStyle}"/>
                                </StackPanel>
                            </Button>
                        </ListBoxItem>

                    </ListBox>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
