<UserControl x:Class="DesktopApp.Views.LobyPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp.Views"
        xmlns:conv="clr-namespace:DesktopApp.Converters" 
        mc:Ignorable="d"
        Background="#F8FAFC"
        d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.Resources>
        <conv:StatusToInVisibilityConverter x:Key="StatusToInVisibilityConverter"/>
        <conv:StatusToOutVisibilityConverter x:Key="StatusToOutVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="5,10,0,10" Background="White">
            <TextBlock Text="Panel diarío" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Reservas con fecha inicio/fin para hoy" Foreground="Gray"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal"  Margin="5,5,0,0">
            <StackPanel>
                <TextBlock Text="Buscar Cliente/ID:" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                <TextBox Width="200" 
                 Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalContentAlignment="Center" Height="5"
                 Style="{StaticResource InputTextBox}"/>
            </StackPanel>
            <Button Grid.Column="1" 
                Content="🔄 Recarga " 
                Padding="15,5" 
                VerticalAlignment="Bottom"
                Margin="10,0,0,0"
                Height="40"
                Width="100"
                Command="{Binding RecargarCommand}"
                Style="{StaticResource SecondaryButton}"/>  
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DataGrid Grid.Row="1" ItemsSource="{Binding ReservasHoy}" AutoGenerateColumns="False" CanUserAddRows="False" 
  IsReadOnly="True"  SelectionChanged="DataGrid_SelectionChanged" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*"/>
                    <DataGridTextColumn Header="Habitaciones" Binding="{Binding NumeroHabitacion}" Width="*"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>

                    <DataGridTemplateColumn Header="Acciones">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Check-in" 
                                        Margin="2" Padding="10,5" Width="100"
                                        Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding Status, Converter={StaticResource StatusToInVisibilityConverter}}"
                                        Style="{StaticResource SecondaryButton}"/>

                                    <Button Content="Check-out" 
                                        Margin="2" Padding="10,5" Width="100"
                                        Command="{Binding DataContext.CheckOutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding Status, Converter={StaticResource StatusToOutVisibilityConverter}}"
                                        Style="{StaticResource SecondaryButton}"/>  

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
    </Grid>
</UserControl>