<Window x:Class="DesktopApp.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/images/icoproyecto.ico">
    
    <Grid  Background="{StaticResource BackgroundBrush2}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="50" Width="50" Height="50" Margin="0 0 0 20">
                <Path Fill="{StaticResource BackgroundBrush2}"
                Width="18" Height="18" Stretch="Uniform"
                Data="{StaticResource IcoUser}"/>
            </Border>
            <TextBlock  Text="Iniciar Sesión" Style="{StaticResource Titulo1}" TextAlignment="Center"/>
            <TextBlock  Text="Ingresa tus credenciales para continuar" Style="{StaticResource Subtitulo1}"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="2" Margin="70 20 70 0">
            <Label Content="Correo Electronico" Margin="0,0,0,5" Style="{StaticResource labelFormulario}"/>
            <Border Style="{StaticResource bordePaleta}">
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="40" Style="{StaticResource itemhijo}" />
            </Border>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="3" Margin="70 20 70 0">
            <Label Content="Contraseña" Margin="0,0,0,5" Style="{StaticResource labelFormulario}"/>
            <Border Background="White" Style="{StaticResource bordePaleta}">
                <PasswordBox x:Name="txtPassword" Height="40" Style="{StaticResource itemhijo}"/>
            </Border>
        </StackPanel>

        <Button Content="Iniciar Sesión" Grid.Row="4"  Height="30"  Width="250" Style="{StaticResource accentButton}"
                Command="{Binding LoginCommand}" 
                CommandParameter="{Binding ElementName=txtPassword}" />
    </Grid>
</Window>
