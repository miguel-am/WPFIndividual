<UserControl x:Class="DesktopApp.Views.ListLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Background="#F8FAFC">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="Auto"/>
            <!-- Filtros -->
            <RowDefinition Height="*"/>
            <!-- Tabla Principal -->
            <RowDefinition Height="250"/>
            <!-- Comparativa Inferior -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Auditoría de Sistema" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Historial de cambios y seguimiento de reservas" Foreground="Gray"/>
        </StackPanel>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="#F8F9FA" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="Filtrar por Empleado:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Width="150" Style="{StaticResource InputTextBox}" Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Acción:" VerticalAlignment="Top" Margin="20,0,10,0"/>
                    <ComboBox Width="130"  Height="40" ItemsSource="{Binding AccionesDisponibles}" SelectedItem="{Binding FiltroAccion}" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Fecha Modificación:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <DatePicker Height="40" SelectedDate="{Binding FiltroFechaModificacion}" Width="Auto"/>
                </StackPanel>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Para la reserva del:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <DatePicker Height="40" SelectedDate="{Binding FiltroFechaReserva}" Width="Auto"/>
                </StackPanel>
                <Button  Content="Limpiar Filtros" Command="{Binding LimpiarFiltrosCommand}"  Style="{StaticResource ActionButton}" Background="#6B7280" Margin="50,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Tabla Principal -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FiltroLogs}" SelectedItem="{Binding LogSeleccionado}"
                  AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F2F2F2" BorderBrush="#DDD"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="130"/>
                <DataGridTextColumn Header="Autor Cambio" Binding="{Binding NombreActor}" Width="*"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding ActorRole}" Width="100"/>
                <DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="120"/>
                <DataGridTextColumn Header="Día Reserva" Binding="{Binding FechaReserva, StringFormat=\{0:dd/MM/yyyy\}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Paneles de Comparación (Legibles) -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Estado Anterior" Margin="0,0,5,0" BorderThickness="1" BorderBrush="#CCC">
                <DataGrid IsReadOnly="True" ItemsSource="{Binding LogSeleccionado.OldStateList}" AutoGenerateColumns="False" HeadersVisibility="None" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" BorderBrush="Blue">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Propiedad}" FontWeight="Bold" Width="120"/>
                        <DataGridTextColumn Binding="{Binding Valor}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Estado Nuevo" Margin="5,0,0,0" BorderThickness="1" BorderBrush="#007ACC">
                <DataGrid IsReadOnly="True" ItemsSource="{Binding LogSeleccionado.NewStateList}" AutoGenerateColumns="False" HeadersVisibility="None" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White" BorderBrush="Blue">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Propiedad}" FontWeight="Bold" Foreground="#007ACC" Width="120"/>
                        <DataGridTextColumn Binding="{Binding Valor}" Width="*" Foreground="#2C3E50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>