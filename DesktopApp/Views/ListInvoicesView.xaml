<UserControl x:Class="DesktopApp.Views.ListInvoicesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp.Views"
        mc:Ignorable="d"
        Background="#F8FAFC"
        d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Listado Facturas" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Historial de facturas" Foreground="Gray"/>
        </StackPanel>
        <DockPanel LastChildFill="False" Margin="0,0,0,15" Grid.Row="1">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Buscar Cliente/ID:" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox Width="200" 
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center" Height="5"
                             Style="{StaticResource InputTextBox}"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Filtrar por Fecha:" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                    <DatePicker Width="150" 
                                SelectedDate="{Binding FechaFiltro, UpdateSourceTrigger=PropertyChanged}" 
                                Height="40" VerticalAlignment="Bottom"
/>
                </StackPanel>
                <Button Content="Limpiar Filtros" 
                    Command="{Binding LimpiarFiltrosCommand}" 
                    Margin="0,0,10,0" 
                    Background="Gray" Foreground="White" 
                    Padding="15,0" Height="30"
                    Style="{StaticResource ActionButton}"
                        VerticalAlignment="Bottom"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Bottom">
                <Button Content="Descargar PDF" 
                        Command="{Binding DescargarCommand}" 
                        Margin="0,0,10,0" 
                        Background="#10B981" Foreground="White" 
                        Padding="15,0" Height="30"
                        Style="{StaticResource ActionButton}"/>

                <Button Content="Reenviar Email" 
                        Command="{Binding ReenviarEmailCommand}" 
                        Background="#3B82F6" Foreground="White" 
                        Padding="15,0" Height="30"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding FacturasFiltradas}" 
                  SelectedItem="{Binding FacturaSeleccionada}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  RowHeight="35"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#E2E8F0"
                  Style="{StaticResource ModernDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="# Factura" Binding="{Binding InvoiceNumber}" Width="Auto"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*"/>
                <DataGridTextColumn Header="Importe" Binding="{Binding Total, StringFormat={}{0:C}}" Width="100"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>