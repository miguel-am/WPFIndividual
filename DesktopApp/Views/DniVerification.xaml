<Window x:Class="DesktopApp.Views.DniVerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verificación de Identidad" Height="180" Width="350" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Introduce el DNI del titular:" Margin="0,0,0,10" FontWeight="Bold"/>
            <TextBox x:Name="TxtDni" Height="50" VerticalContentAlignment="Center" FontSize="16" Style="{StaticResource InputTextBox}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancelar" Click="Cancel_Click" Width="80" Margin="0,0,10,0"/>
                <Button Content="Verificar" Click="Verify_Click" Width="80" Background="#2563EB" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>