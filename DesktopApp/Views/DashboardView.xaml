<UserControl x:Class="DesktopApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource BackgroundBrush2}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Imagen -->
            <Image Source="/Resources/images/icono_proyecto.png"
                   Width="200"
                   Height="200"
                   Stretch="Uniform"
                   Opacity="0.95"/>

            <TextBlock Text="Sistema de Gestión Hotelera"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</UserControl>
