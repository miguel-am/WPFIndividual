<Window x:Class="DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp"
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:DesktopApp.Controls"
        Title="MainWindow" Height="720" Width="1280" MinWidth="1024" MinHeight="600"
        Icon="/Resources/images/icoproyecto.ico">
   
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <controls:HeaderControl x:Name="HeaderControl" Grid.Row="0" Grid.Column="1"  Height="60"/>

        <controls:navControl Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"/>

        <ContentControl Content="{Binding CurrentView}"  Grid.Row="1" Grid.Column="1"  />

    </Grid>
</Window>
 