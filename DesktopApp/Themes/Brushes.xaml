<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrushDark" Color="{StaticResource BackgroundHeaderColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush2" Color="{StaticResource BackgroundColor2}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="CancelBrush" Color="{StaticResource CancelColor}"/>
    <SolidColorBrush x:Key="UpdateBrush" Color="{StaticResource UpdateColor}"/>
    <SolidColorBrush x:Key="ReturnBrush" Color="{StaticResource ReturnColor}"/>
</ResourceDictionary>